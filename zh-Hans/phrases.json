    "tags": [
      "spring"
    ]
  },
  {
    "text": "夏云亘百里，合沓遥相连。——刘长卿",
    "author": "刘长卿",
    "work": "关门望华山",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.7000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "旋折荷花伴歌舞，夕阳斜照满衣红。——花蕊夫人徐氏",
    "author": "花蕊夫人徐氏",
    "work": "宫词 二十五",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.43000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "喜见夏日来，变为松景清。——孟郊",
    "author": "孟郊",
    "work": "题从叔述灵岩山壁",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.19000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "千峰鸟路含梅雨，五月蝉声送麦秋。——李嘉祐",
    "author": "李嘉祐",
    "work": "句",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.49000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "水泛芙蕖影，桥临芳桂丛。——杨师道",
    "author": "杨师道",
    "work": "五言早秋[仪鸾殿]侍宴应诏",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.52000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "兽皮裁褥暖，莲叶制衣馨。——唐求",
    "author": "唐求",
    "work": "送友人江行之庐山肄业",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.40000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "华堂清暑榕阴重，梦里江寒。——张元干",
    "author": "张元干",
    "work": "采桑子",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.3000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "纤手折芙蕖，花洒罗衫湿。——顾非熊",
    "author": "顾非熊",
    "work": "采莲词",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.27000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "炎炎夏日满天时，桐叶交加覆玉墀。——王涯",
    "author": "王涯",
    "work": "宫词三十首 十九",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.18000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "夏日旧来长，佳游何易暮。——皎然",
    "author": "皎然",
    "work": "惜暮景",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.45000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "数朵芙蕖，嫣然一笑凌清晓。——汪莘",
    "author": "汪莘",
    "work": "点绛唇",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.12000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "鱼倾荷叶露，蝉噪柳林风。——许浑",
    "author": "许浑",
    "work": "泛五云溪",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.29000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "峰峰寒列簇芙蕖，静想嵩阳秀不如。——缪岛云",
    "author": "缪岛云",
    "work": "望黄山诸峯",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.50000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "竹粉翻新箨，荷花拭靓妆。——程垓",
    "author": "程垓",
    "work": "望秦川・南歌子",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.11000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "欸乃渔歌，深入荷花去。——倪偁",
    "author": "倪偁",
    "work": "蝶恋花",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.8000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "夏云随北帆，同日过江来。——张说",
    "author": "张说",
    "work": "四月一日过江赴荆州",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.4000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "采莲朅来水无风，莲潭如鉴松如龙。——鲍溶",
    "author": "鲍溶",
    "work": "采莲曲二首 二",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.26000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "嫩荷花里摇船去，一阵香风逐水来。——花蕊夫人徐氏",
    "author": "花蕊夫人徐氏",
    "work": "宫词 一百九",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.43000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "鱼戏莲叶北，澄阳动微涟。——陆龟蒙",
    "author": "陆龟蒙",
    "work": "相和歌辞 江南曲 五",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.1000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "色浓春草在，峰起夏云归。——皎然",
    "author": "皎然",
    "work": "夏日同崔使君论登城楼赋得远山",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.45000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "独占芳菲当夏景，不将颜色托春风。——白居易",
    "author": "白居易",
    "work": "紫薇花",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.23000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "spring",
      "summer"
    ]
  },
  {
    "text": "鱼网平铺荷叶，鹭鸶闲步稻苗。——李嘉祐",
    "author": "李嘉祐",
    "work": "白田西忆楚州使君弟",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.10000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "繁杏新荷春夏景，疏梅细菊秋冬约。——吕胜己",
    "author": "吕胜己",
    "work": "满江红",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.10000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "湛露宜清暑，披香正满轩。——羊士谔",
    "author": "羊士谔",
    "work": "南池荷花",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.17000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "荷叶罩芙蓉，圆青映嫩红。——曹脩古",
    "author": "曹脩古",
    "work": "池上",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.42000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "座纳薰风细，帘垂白日长。——戴叔伦",
    "author": "戴叔伦",
    "work": "南轩",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.14000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "summer"
    ]
  },
  {
    "text": "旧溪红藓在，秋水绿痕生。——杨巨源",
    "author": "杨巨源",
    "work": "秋日韦少府厅池上咏石",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.17000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "夕照留山馆，秋光落草田。——李嘉祐",
    "author": "李嘉祐",
    "work": "句容县东青阳馆作",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.10000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "与尔期此亭，期在秋月满。——李白",
    "author": "李白",
    "work": "寻阳送弟昌峒鄱阳司马作",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.8000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "飘荡云海深，相思桂花白。——羊士谔",
    "author": "羊士谔",
    "work": "九月十日郡楼独酌",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.17000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "桂花如入手，愿作从游人。——郑谷",
    "author": "郑谷",
    "work": "干符丙申岁奉试春涨曲江池",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.37000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "弄玉已归萧史去，碧楼红树倚斜阳。——赵嘏",
    "author": "赵嘏",
    "work": "经王先生故居",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.30000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "秋色池馆静，雨声云木凉。——杜牧",
    "author": "杜牧",
    "work": "过鲍溶宅有感",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.28000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "秋色有佳兴，况君池上闲。——王维",
    "author": "王维",
    "work": "崔濮阳兄季重前山兴",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.5000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "好傍翠楼装月色，枉随红叶舞秋声。——罗邺",
    "author": "罗邺",
    "work": "芦花",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.36000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "谢公秋思渺天涯，蜡屐登高为菊花。——令狐楚",
    "author": "令狐楚",
    "work": "奉和严司空重阳日同崔常侍崔郎及诸公登龙山落帽台佳宴",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.17000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "秋水莲花三四枝，我来慷慨步迟迟。——来鹄",
    "author": "来鹄",
    "work": "古劒池",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.35000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "乾坤爽气满，台殿秋光清。——德宗皇帝",
    "author": "德宗皇帝",
    "work": "重阳日赐宴曲江亭赋六韵诗用清字",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.0.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "津亭折柳，正秋光如画。——刘埙",
    "author": "刘埙",
    "work": "洞仙歌",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.17000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "钟声催野饭，秋色落寒潮。——马戴",
    "author": "马戴",
    "work": "送僧归闽中旧寺",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.30000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "碧云萧寺霁，红树谢邨秋。——司空图",
    "author": "司空图",
    "work": "寄永嘉崔道融",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.34000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "江畔枫叶初带霜，渚边菊花亦已黄。——贾至",
    "author": "贾至",
    "work": "初至巴陵与李十二白裴九同泛洞庭湖三首 三",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.12000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "陶令南行心自永，江天极目澄秋景。——钱起",
    "author": "钱起",
    "work": "送马明府赴江陵",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.12000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "山亭秋色满，岩牖凉风度。——太宗皇帝",
    "author": "太宗皇帝",
    "work": "山阁晚秋",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.0.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "夜深吹笛移船去，三十六湾秋月明。——许浑",
    "author": "许浑",
    "work": "三十六湾",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.29000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "问甚时同赋，三十六陂秋色。——姜夔",
    "author": "姜夔",
    "work": "惜红衣",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.12000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "百川灌彭蠡，秋水方浩浩。——吴筠",
    "author": "吴筠",
    "work": "登庐山东峰观九江合彭蠡湖",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.47000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "今日俄重九，莫负菊花开。——韩元吉",
    "author": "韩元吉",
    "work": "水调歌头",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.8000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "夜村机杼急，秋水芰荷深。——卢纶",
    "author": "卢纶",
    "work": "陪中书李纾舍人夜泛东池",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.14000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "门户饶秋景，儿童解冷吟。——姚合",
    "author": "姚合",
    "work": "寄国子杨巨源祭酒",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.26000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "碧潭宵见月，红树晚开花。——宋鼎",
    "author": "宋鼎",
    "work": "酬故人还山",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.5000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "溥露浸秋色，零雨濯湖弦。——魏了翁",
    "author": "魏了翁",
    "work": "水调歌头",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.13000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "autumn"
    ]
  },
  {
    "text": "寄语寒梅休放尽，留取三花两蕊。——吴潜",
    "author": "吴潜",
    "work": "贺新郎",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.15000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "雪尽玉容开遍，东风不管寒梅。——叶梦得",
    "author": "叶梦得",
    "work": "清平乐",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.5000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "梅花满眼，一朵聊当一千秋。——王质",
    "author": "王质",
    "work": "水调歌头",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.10000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "超然坐久，幽径试寻寒梅。——曹勋",
    "author": "曹勋",
    "work": "法曲入破第三・法曲",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.7000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "一树寒梅白玉条，逈临林村傍谿桥。——张谓",
    "author": "张谓",
    "work": "早梅",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.9000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "邨梅尚敛风前笑，沙草初偷雪后春。——李群玉",
    "author": "李群玉",
    "work": "送人隐居",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.31000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "从今克己应犹及，颜与梅花具自新。——卢仝",
    "author": "卢仝",
    "work": "人日立春",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.20000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "寒风金磬远，晴雪玉楼重。——许浑",
    "author": "许浑",
    "work": "冬日宣城开元寺赠元孚上人",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.29000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "广陌万人生喜色，曲江千树发寒梅。——刘沧",
    "author": "刘沧",
    "work": "看牓日",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.32000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "更翦翦梅花，落云阶月地。——赵以夫",
    "author": "赵以夫",
    "work": "征招",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.14000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "梅花似雪柳含烟，南地风光腊月前。——韦同则",
    "author": "韦同则",
    "work": "仲月赏花",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.16000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "坐对梅花笑，还记初度年时。——赵文",
    "author": "赵文",
    "work": "塞翁吟",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.17000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "去鴈声遥人语绝，谁家素机织新雪。——施肩吾",
    "author": "施肩吾",
    "work": "秋夜山居二首 二",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.26000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "鬬雪梅先吐，惊风柳未舒。——上官昭容",
    "author": "上官昭容",
    "work": "游长宁公主流杯池二十五首 九",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.0.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "雪晴看鹤去，海夜与龙期。——司空曙",
    "author": "司空曙",
    "work": "寄天台秀师",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.15000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "细韵风中远，寒青雪后浓。——徐铉",
    "author": "徐铉",
    "work": "北苑侍宴杂咏诗 松",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.42000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "杲杲冬日出，照我屋南隅。——白居易",
    "author": "白居易",
    "work": "负冬日",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.22000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "山树落梅花，飞落野人家。——刘希夷",
    "author": "刘希夷",
    "work": "春日行歌",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.4000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "上苑梅花早，御沟杨柳新。——骆宾王",
    "author": "骆宾王",
    "work": "西行别东台详正学士",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.4000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "春到园中，见寒梅同春雪乱飞。——沈瀛",
    "author": "沈瀛",
    "work": "野庵曲",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%AE%8B%E8%AF%8D/ci.song.10000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "芸细书中气，松疎雪后阴。——李频",
    "author": "李频",
    "work": "冬夜和范秘书宿秘省中作",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.32000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "柳色迎三月，梅花隔二年。——李百药",
    "author": "李百药",
    "work": "奉和初春出游应令",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.2000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "未腊梅先实，经冬草自薰。——许浑",
    "author": "许浑",
    "work": "岁暮自广江至新兴往复中题峡山寺四首 一",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.29000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "北风微雪后，晚景有云时。——陈季卿",
    "author": "陈季卿",
    "work": "别兄弟",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.48000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "借问梅花何处落，风吹一夜满关山。——宋济",
    "author": "宋济",
    "work": "塞上闻笛",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.25000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "winter"
    ]
  },
  {
    "text": "尽说青云路，有足皆可至。——孟郊",
    "author": "孟郊",
    "work": "长安旅情",
    "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/%E5%85%A8%E5%94%90%E8%AF%97/poet.tang.19000.json",
    "rights": "古典原文；来源数据 MIT（JackeyGao，2016）",
    "tags": [
      "uplifting"
    ]
  },
  {
    "text": "行冲赤日加餐饭，上到青云稳着鞭。——白居易",
